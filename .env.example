# Public: safe to expose. RLS limits the anon key to SELECT on deals.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either name works: Supabase's newer "publishable" key or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret: only for `npm run seed` and GitHub Actions scrapers. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical URL for metadata/sitemap once you have a custom domain.
# NEXT_PUBLIC_SITE_URL=https://zerocatch.example

# Secret: password for /admin/review. Use a long random string.
ADMIN_PASSWORD=change-me

# Vercel only: on-time nightly scrape (see vercel.json and src/app/api/cron/scrape).
# CRON_SECRET: random string; Vercel sends it to the cron route automatically.
# GITHUB_DISPATCH_TOKEN: fine-grained GitHub token for this repo with Actions: Read and write.
# CRON_SECRET=
# GITHUB_DISPATCH_TOKEN=
